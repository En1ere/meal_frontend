{
    "name": "meal-frontend",
    "version": "0.0.40",
    "private": true,
    "type": "module",
    "workspaces": [
        "front",
        "design-system"
    ],
    "engines": {
        "node": ">=24.19.0 <25",
        "npm": ">=11 <12"
    },
    "packageManager": "npm@11.12.1",
    "scripts": {
        "dev": "npm --workspace front run dev",
        "dev:client": "npm --prefix front run dev",
        "start": "npm --workspace front run start",
        "check": "npm --workspace design-system run check && npm --workspace front run check && npm run ops:readiness && npm run test:ops",
        "build": "npm --workspace front run build",
        "test": "npm --workspace design-system test && npm --workspace front test",
        "test:e2e:front": "node scripts/run-front-e2e-isolated.mjs",
        "test:e2e:front:raw": "playwright test --config playwright.front.config.ts",
        "test:e2e:front:production": "npm run build && playwright test --config playwright.front.production.config.ts",
        "test:performance:budget": "npm run build && node scripts/check-browser-budget.mjs",
        "test:integration": "node scripts/check-integration.mjs",
        "ops:readiness": "node scripts/check-production-readiness.mjs",
        "ops:readiness:require-ready": "node scripts/check-production-readiness.mjs --require-ready",
        "test:ops": "node --test scripts/check-production-readiness.test.mjs scripts/production-acceptance.test.mjs",
        "production:acceptance": "node scripts/production-acceptance.mjs"
    },
    "devDependencies": {
        "@playwright/test": "1.63.0",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    }
}
