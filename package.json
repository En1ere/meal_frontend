{
    "name": "meal-frontend",
    "version": "0.0.2",
    "private": true,
    "type": "module",
    "workspaces": [
        "front",
        "design-system"
    ],
    "engines": {
        "node": ">=24.19.0 <25",
        "npm": ">=11 <12"
    },
    "packageManager": "npm@11.12.1",
    "scripts": {
        "dev": "npm --workspace front run dev",
        "dev:client": "npm --prefix front run dev",
        "start": "npm --workspace front run start",
        "check": "npm --workspace design-system run check && npm --workspace front run check",
        "build": "npm --workspace front run build",
        "test": "npm --workspace design-system test && npm --workspace front test",
        "test:e2e:front": "playwright test --config playwright.front.config.ts",
        "test:integration": "node scripts/check-integration.mjs"
    },
    "devDependencies": {
        "@playwright/test": "1.63.0",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    }
}
