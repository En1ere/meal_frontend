{
    "name": "meal-planner-frontend-admin",
    "version": "0.0.95",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24.19.0 <25",
        "npm": ">=11 <12"
    },
    "packageManager": "npm@11.12.1",
    "scripts": {
        "dev": "vite",
        "build": "tsc -p tsconfig.json --noEmit && vite build",
        "start": "vite preview",
        "build:mocks": "tsc -p tsconfig.test.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "npm run build:mocks && node --test dist/test/*.test.js",
        "lint": "eslint . && prettier --check . && npm run lint:css",
        "lint:css": "stylelint \"src/**/*.css\"",
        "format": "prettier --write .",
        "contracts:generate": "node scripts/generate-contracts.mjs",
        "contracts:check": "node scripts/generate-contracts.mjs --check",
        "check": "npm run contracts:check && npm run typecheck && npm run lint && npm test",
        "preview": "vite preview"
    },
    "dependencies": {
        "@meal-planner/design-system": "file:../design-system",
        "@tanstack/react-query": "5.103.2",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-router-dom": "7.18.3",
        "zod": "4.6.7",
        "zustand": "5.0.15"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "24.13.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.1",
        "eslint": "10.11.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "fake-indexeddb": "6.2.5",
        "globals": "17.12.0",
        "msw": "2.15.0",
        "otplib": "13.5.0",
        "prettier": "3.9.9",
        "stylelint": "17.15.0",
        "stylelint-config-standard": "40.0.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.1",
        "vite": "8.2.2"
    }
}
