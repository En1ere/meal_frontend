# npm run dev defaults to browser mocks; no backend/database required.
NEXT_PUBLIC_API_MODE=mock
# For real mode after migration; Next proxies /api to Nest.
BACKEND_ORIGIN=http://127.0.0.1:3001
# Optional public SemVer release label; never put secrets into NEXT_PUBLIC_*.
# NEXT_PUBLIC_APP_VERSION=0.0.0
