{
    "name": "meal-planner-front",
    "version": "0.0.148",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24.19.0 <25",
        "npm": ">=11 <12"
    },
    "packageManager": "npm@11.12.1",
    "scripts": {
        "dev": "next dev --webpack -p 3000",
        "build": "next build --webpack",
        "start": "next start -p 3000",
        "build:mocks": "tsc -p tsconfig.test.json",
        "architecture:check": "node scripts/check-architecture.mjs",
        "typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
        "test": "npm run build:mocks && node --test dist/test/*.test.js",
        "lint": "eslint . && prettier --check . && npm run lint:css",
        "lint:css": "stylelint \"src/**/*.css\"",
        "format": "prettier --write .",
        "contracts:generate": "node scripts/generate-contracts.mjs",
        "contracts:check": "node scripts/generate-contracts.mjs --check",
        "check": "npm run contracts:check && npm run architecture:check && npm run typecheck && npm run lint && npm test"
    },
    "dependencies": {
        "@meal-planner/design-system": "file:../design-system",
        "@tanstack/react-query": "5.103.2",
        "@zxing/browser": "0.2.1",
        "next": "16.4.3",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "tesseract.js": "7.0.0",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
        "zod": "4.6.7",
        "zustand": "5.0.15"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "24.13.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "eslint": "10.11.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "fake-indexeddb": "6.2.5",
        "globals": "17.12.0",
        "msw": "2.15.0",
        "otplib": "13.5.0",
        "prettier": "3.9.9",
        "sharp": "0.35.5",
        "stylelint": "17.15.0",
        "stylelint-config-standard": "40.0.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.1"
    }
}
